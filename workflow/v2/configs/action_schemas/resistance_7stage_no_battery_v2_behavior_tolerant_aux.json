{
  "schema_version": "resistance_action_schema.v2_behavior_tolerant_aux",
  "stage_schema_id": "resistance_7stage_no_battery_v2",
  "experiment": "伏安法测电阻",
  "description": "在 v2 Temporal Guard 上增加行为容错解码与不竞争的辅助动作，七阶段主输出保持兼容。",
  "base_actions": [
    {"id": "wiring_action", "label_zh": "接线动作", "definition": "摆放器材，插接、拔出或调整实验线路。"},
    {"id": "measurement_action", "label_zh": "测量动作", "definition": "操作开关、观察仪表或读取示数；不包含书写。"},
    {"id": "writing_action", "label_zh": "书写动作", "definition": "笔尖接触记录纸并填写、书写或计算。"},
    {"id": "cleanup_action", "label_zh": "最终整理动作", "definition": "连续拆线、收拢器材或把橙红色仪器放回桌子左上角。"},
    {"id": "auxiliary_action", "label_zh": "辅助动作", "definition": "电池配置变化、教师介入、换座位、闲聊、手机、离题或其他七阶段之外的可见行为。"},
    {"id": "uncertain", "label_zh": "无法判断", "definition": "当前画面不足以可靠归入其他基础动作。"}
  ],
  "stages": [
    {"id": "circuit_wiring", "order": 1, "label_zh": "连线", "required_base_action": "wiring_action"},
    {"id": "measurement_1", "order": 2, "label_zh": "第一次测量", "required_base_action": "measurement_action"},
    {"id": "recording_1", "order": 3, "label_zh": "第一次记录", "required_base_action": "writing_action"},
    {"id": "circuit_rewiring", "order": 4, "label_zh": "重新连线", "required_base_action": "wiring_action"},
    {"id": "measurement_2", "order": 5, "label_zh": "第二次测量", "required_base_action": "measurement_action"},
    {"id": "recording_2", "order": 6, "label_zh": "第二次记录", "required_base_action": "writing_action"},
    {"id": "material_cleanup", "order": 7, "label_zh": "整理材料", "required_base_action": "cleanup_action", "absorbing_terminal": true}
  ],
  "state_machine_rules": [
    "短测量后的接线保留纠错和正式第二轮两种带惩罚假设。",
    "集中书写保留 recording_1 与 recording_2 两个检索别名，不切断连续书写。",
    "辅助动作不直接推进七阶段，也不与同时发生的主动作互斥。",
    "电池配置变化在二十秒内仅作为正式重新连线的辅助证据。",
    "换座位和闲聊不能单独生成整理阶段。"
  ]
}
